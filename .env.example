# Copy to .env and fill in.
# Password for the ctm dashboard/API. Leave empty for no login (only safe
# while ctm is reachable from this machine alone, the compose default).
# Generate one with: openssl rand -hex 32
CTM_TOKEN=
# Claude credentials are optional here: you can sign in from the dashboard
# (Claude account page) or with `ctm auth login` instead.
ANTHROPIC_API_KEY=
# Or, instead of an API key, a token from `claude setup-token`:
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: lets runs clone/push private GitHub repos.
GH_TOKEN=
CTM_MAX_CONCURRENT=4
